{
  "name": "clippay",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "paypal:week1": "tsx scripts/paypal-week1.ts",
    "typecheck": "tsc --noEmit",
    "grade": "tsx scripts/grade-photos.ts",
    "test": "tsx --test 'src/**/*.test.ts'",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:migrate": "wrangler d1 migrations apply clippay --remote",
    "db:seed-demo": "tsx scripts/export-demo-sql.ts > .open-next/demo.sql && wrangler d1 execute clippay --remote --file .open-next/demo.sql"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@opennextjs/cloudflare": "^1.20.12",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "lucide-react": "^1.59.0",
    "next": "^15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.4.7",
    "eslint": "^9",
    "eslint-config-next": "^15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "wrangler": "^4.151.2"
  }
}
