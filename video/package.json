{
  "name": "clippay-video",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "capture": "node --import ../node_modules/tsx/dist/loader.mjs scripts/capture-screens.ts",
    "render": "remotion render src/index.ts ClipPayDemo out/clippay-demo.mp4 --codec h264 --crf 18 --audio-bitrate 256k",
    "still": "remotion still src/index.ts ClipPayDemo",
    "record-live": "node --import ../node_modules/tsx/dist/loader.mjs scripts/record-live.ts",
    "assemble-live": "node scripts/assemble-live.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.537",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@remotion/renderer": "4.0.537",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@types/react": "^19",
    "puppeteer-core": "^24",
    "typescript": "^5"
  }
}
